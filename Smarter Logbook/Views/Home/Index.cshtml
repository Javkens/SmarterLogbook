@using Smarter_Logbook.Services
@model FlightLogPageViewModel
@{
    ViewData["Title"] = "CSV converter";
}

<section class="hero">
    <p class="eyebrow">Smarter Logbook</p>
    <h1>Turn flight logs into a ready-to-import CSV.</h1>
    <p class="intro">Upload the exported flight log, review every converted value, then download the finished file.</p>
</section>

<section class="upload-panel" aria-labelledby="upload-title">
    <div>
        <h2 id="upload-title">1. Upload a flight-log CSV</h2>
        <p>The file is processed in your browser session and is not stored.</p>
    </div>
    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="upload-form">
        <label class="file-picker" for="csvFile">
            <span>Choose CSV file</span>
            <input id="csvFile" name="csvFile" type="file" accept=".csv,text/csv" required />
        </label>
        <button class="btn btn-primary" type="submit">Review flights</button>
    </form>
</section>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

@if (Model.Flights.Count > 0)
{
    <section class="review-panel" aria-labelledby="review-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">@Model.Flights.Count flight@(Model.Flights.Count == 1 ? string.Empty : "s") found</p>
                <h2 id="review-title">2. Review and edit</h2>
                <p>Change any value before exporting. A value in <em>Instr./Pas.</em> sends total time to Dual Received; otherwise it goes to Pilot in Command.</p>
            </div>
            <button class="btn btn-outline-primary" type="button" id="add-row">Add flight</button>
        </div>

        <form asp-action="Download" method="post" id="flight-form">
            <div class="table-responsive">
                <table class="table align-middle flight-table">
                    <thead>
                    <tr>
                        <th class="include-flight"><span class="visually-hidden">Include</span></th><th>Date</th><th>Flight #</th><th>Aircraft</th><th>Model</th><th>From</th><th>To</th>
                        <th>Departed</th><th>Arrived</th><th>Takeoff</th><th>Landing</th><th>Total</th><th>Pilot in Command</th><th>Dual Received</th>
                        <th>Takeoffs</th><th>Remarks</th>
                    </tr>
                    </thead>
                    <tbody id="flight-rows">
                    @for (var index = 0; index < Model.Flights.Count; index++)
                    {
                        <tr>
                            <td class="include-flight">
                                <input asp-for="Flights[index].Selected" aria-label="Include this flight" />
                            </td>
                            <td><input asp-for="Flights[index].Date" type="date" /></td>
                            <td><input asp-for="Flights[index].FlightNumber" /></td>
                            <td><input asp-for="Flights[index].Aircraft" /></td>
                            <td><input asp-for="Flights[index].AircraftModel" /></td>
                            <td><input asp-for="Flights[index].From" /></td>
                            <td><input asp-for="Flights[index].To" /></td>
                            <td><input asp-for="Flights[index].Departed" type="time" /></td>
                            <td><input asp-for="Flights[index].Arrived" type="time" /></td>
                            <td><input asp-for="Flights[index].TakeoffTime" type="time" /></td>
                            <td><input asp-for="Flights[index].LandingTime" type="time" /></td>
                            <td><input asp-for="Flights[index].Total" pattern="[0-9]{2}:[0-9]{2}" /></td>
                            <td><input asp-for="Flights[index].PilotInCommand" pattern="[0-9]{2}:[0-9]{2}" /></td>
                            <td><input asp-for="Flights[index].DualReceived" pattern="[0-9]{2}:[0-9]{2}" /></td>
                            <td><input asp-for="Flights[index].TakeoffsDay" inputmode="numeric" /></td>
                            <td><input asp-for="Flights[index].Remarks" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <fieldset class="column-picker">
                <legend>Columns to include in the downloaded CSV</legend>
                <div class="column-options">
                    @foreach (var column in FlightLogCsvConverter.OutputColumns)
                    {
                        <label>
                            <input type="checkbox" name="SelectedColumns" value="@column.Key"
                                   checked="@Model.SelectedColumns.Contains(column.Key, StringComparer.OrdinalIgnoreCase)" />
                            <span>@column.Header</span>
                        </label>
                    }
                </div>
            </fieldset>
            <div class="export-bar">
                <div><span class="step-number">3</span> Download the converted CSV</div>
                <button class="btn btn-primary" type="submit">Download CSV</button>
            </div>
        </form>
    </section>

    <template id="flight-row-template">
        <tr>
            <td class="include-flight">
                <input name="Flights[__index__].Selected" type="checkbox" value="true" checked aria-label="Include this flight" />
                <input name="Flights[__index__].Selected" type="hidden" value="false" />
            </td>
            <td><input name="Flights[__index__].Date" type="date" /></td>
            <td><input name="Flights[__index__].FlightNumber" /></td>
            <td><input name="Flights[__index__].Aircraft" /></td>
            <td><input name="Flights[__index__].AircraftModel" /></td>
            <td><input name="Flights[__index__].From" /></td>
            <td><input name="Flights[__index__].To" /></td>
            <td><input name="Flights[__index__].Departed" type="time" /></td>
            <td><input name="Flights[__index__].Arrived" type="time" /></td>
            <td><input name="Flights[__index__].TakeoffTime" type="time" /></td>
            <td><input name="Flights[__index__].LandingTime" type="time" /></td>
            <td><input name="Flights[__index__].Total" pattern="[0-9]{2}:[0-9]{2}" /></td>
            <td><input name="Flights[__index__].PilotInCommand" pattern="[0-9]{2}:[0-9]{2}" /></td>
            <td><input name="Flights[__index__].DualReceived" pattern="[0-9]{2}:[0-9]{2}" /></td>
            <td><input name="Flights[__index__].TakeoffsDay" inputmode="numeric" /></td>
            <td><input name="Flights[__index__].Remarks" /></td>
        </tr>
    </template>
}

@section Scripts {
    <script>
        const rows = document.getElementById('flight-rows');
        const template = document.getElementById('flight-row-template');
        const addRow = document.getElementById('add-row');

        if (addRow) {
            addRow.addEventListener('click', () => {
                const row = template.content.cloneNode(true);
                row.querySelectorAll('input').forEach(input => {
                    input.name = input.name.replace('__index__', rows.children.length);
                });
                rows.appendChild(row);
            });
        }
    </script>
}
